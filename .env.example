# Web
INFERENCE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API and persistence
DATABASE_URL=sqlite:///./data/slatesignal.db
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_DAYS=14
AUTO_CREATE_SCHEMA=true
BOOTSTRAP_HISTORICAL_EVALUATIONS=true
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_TOKEN=

# Catalog and demand sources
TMDB_API_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SlateSignal/0.2 contact@example.com

# Model bundle. The ONNX file is local in development and mounted from GCS in Cloud Run.
BERT_ONNX_PATH=./artifacts/bert-base-uncased-fp16.onnx
BERT_TOKENIZER_PATH=./artifacts/bert-tokenizer
GCP_PROJECT_ID=
GCS_MODEL_BUCKET=
